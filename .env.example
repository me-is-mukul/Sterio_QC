# Copy to .env and fill in. .env is git-ignored. Process environment variables win over .env.

# Ollama endpoint: local, or your ngrok URL (no trailing path)
OLLAMA_BASE_URL=http://localhost:11434
# Model tag as shown by `ollama list`
OLLAMA_MODEL=qwen3-vl:4b
# Optional Bearer token if your tunnel/proxy requires one. Never stored.
OLLAMA_API_KEY=

# --- Optional alternative: vLLM / hosted OpenAI-compatible API ---
# INFERENCE_PROVIDER=openai_compatible
# VLLM_BASE_URL=https://<host>/v1
# VLLM_MODEL=Qwen/Qwen3.6-35B-A3B
# VLLM_API_KEY=
