# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
talking_to_mukul.md
# ---------------------------------------------------------------------------
# Local environments and secrets (machine-specific; never commit)
# ---------------------------------------------------------------------------
venv/
.venv/
env/
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Videos and generated data (large, reproducible from the scripts)
# ---------------------------------------------------------------------------
# Each module keeps its input videos in videos/ and its results in outputs/.
*.mp4
*.MP4
*.mov
*.MOV
*.part
*.tmp

# Stereo HOI pipeline
stereo_hoi_pipeline/videos/*
!stereo_hoi_pipeline/videos/.gitkeep
stereo_hoi_pipeline/outputs/*
!stereo_hoi_pipeline/outputs/.gitkeep
# Session lists for run_gcs_batch.py (private bucket paths)
sessions*.txt

# Hand QC: downloaded videos, results, and real clip lists (they contain private links)
hand_qc/videos/
hand_qc/outputs/
hand_qc/clip_lists/*.csv
!hand_qc/clip_lists/example_clip_list.csv

# Logs
*.log
logs/

# ---------------------------------------------------------------------------
# Notebooks, editors, OS, local tool settings
# ---------------------------------------------------------------------------
*.ipynb
.ipynb_checkpoints/
.vscode/
.idea/
.claude/settings.local.json
.DS_Store
Thumbs.db
desktop.ini
confidential_folder/