/*.mp4
/*.MP4
/*.mov
/*.MOV
/videos/
*.part
*.tmp

# Stereo HOI pipeline outputs
output/*
!output/.gitkeep

# Hand QC: downloaded source videos and generated results (re-create with run_hand_qc.py)
hand_qc_cache/
hand_qc/results/

# Logs
*.log
logs/

